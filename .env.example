# Copy to ".env" (same folder as docker-compose.yml). Docker Compose reads it automatically.
# NEVER commit the real .env file.

# postgres (default) | mysql | h2
DB_PROFILE=postgres
COMPOSE_PROFILES=postgres

# Database password (used by the database container AND the application)
DB_PASSWORD=change-me-db

# Passwords of the three API accounts: admin, analyst, ingestion
FRAUD_ADMIN_PASSWORD=change-me-admin
FRAUD_ANALYST_PASSWORD=change-me-analyst
FRAUD_INGESTION_PASSWORD=change-me-ingestion

# Optional rule tuning examples (uncomment to override application.properties)
FRAUD_RULES_HIGH_AMOUNT_THRESHOLD=20000
FRAUD_RULES_VELOCITY_ENABLED=true

    {
      "name": "Ingestion",
      "item": [
        {
          "name": "Submit clean transaction (INGESTION)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/transactions",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{ingestionUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{ingestionPassword}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"POSTMAN-CLEAN-{{$guid}}\",\n  \"customerId\": {{customerId}},\n  \"amount\": 120.50,\n  \"merchantName\": \"Postman Corner Shop\",\n  \"merchantCategory\": \"GROCERIES\",\n  \"country\": \"ZA\",\n  \"occurredAt\": \"{{$isoTimestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Transaction accepted', function () { pm.response.to.have.status(201); });",
                  "pm.test('Ordinary transaction is not flagged (unless another rule applies)', function () { pm.expect(pm.response.json().transaction.id).to.be.a('number'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit high-value transaction (INGESTION)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/transactions",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{ingestionUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{ingestionPassword}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"POSTMAN-HIGH-{{$guid}}\",\n  \"customerId\": {{customerId}},\n  \"amount\": 60000.00,\n  \"merchantName\": \"Postman Electronics\",\n  \"merchantCategory\": \"RETAIL\",\n  \"country\": \"ZA\",\n  \"occurredAt\": \"{{$isoTimestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('High-value transaction accepted and screened', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.environment.set('highTransactionReference', data.transaction.reference);",
                  "pm.environment.set('highTransactionId', data.transaction.id);",
                  "const highFlag = (data.flags || []).find(f => f.ruleCode === 'HIGH_AMOUNT');",
                  "if (highFlag) pm.environment.set('flagId', highFlag.id);",
                  "pm.test('HIGH_AMOUNT rule fired', function () { pm.expect(highFlag, 'HIGH_AMOUNT flag').to.exist; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit transaction to blacklisted merchant (INGESTION)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/transactions",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{ingestionUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{ingestionPassword}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"POSTMAN-BLACKLIST-{{$guid}}\",\n  \"customerId\": {{customerId}},\n  \"amount\": 350.00,\n  \"merchantName\": \"{{testMerchantName}}\",\n  \"merchantCategory\": \"OTHER\",\n  \"country\": \"ZA\",\n  \"occurredAt\": \"{{$isoTimestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Blacklisted-merchant transaction accepted and screened', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "const hit = (data.flags || []).find(f => f.ruleCode === 'BLACKLIST_MERCHANT');",
                  "if (hit) pm.environment.set('blacklistFlagId', hit.id);",
                  "pm.test('BLACKLIST_MERCHANT rule fired', function () { pm.expect(hit, 'BLACKLIST_MERCHANT flag').to.exist; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit atomic batch (INGESTION)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/transactions/batch",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{ingestionUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{ingestionPassword}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactions\": [\n    {\n      \"reference\": \"POSTMAN-BATCH-1-{{$guid}}\",\n      \"customerId\": {{customerId}},\n      \"amount\": 45.00,\n      \"merchantName\": \"Batch Grocer\",\n      \"merchantCategory\": \"GROCERIES\",\n      \"country\": \"ZA\",\n      \"occurredAt\": \"{{$isoTimestamp}}\"\n    },\n    {\n      \"reference\": \"POSTMAN-BATCH-2-{{$guid}}\",\n      \"customerId\": {{customerId}},\n      \"amount\": 85.00,\n      \"merchantName\": \"Batch Pharmacy\",\n      \"merchantCategory\": \"UTILITIES\",\n      \"country\": \"ZA\",\n      \"occurredAt\": \"{{$isoTimestamp}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Batch accepted atomically', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.test('Both batch items were processed', function () { pm.expect(data.received).to.eql(2); pm.expect(data.results).to.have.length(2); });"
                ]
              }
            }
          ]
        }
      ]
    },
